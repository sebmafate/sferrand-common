<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SFerrand.Common</RootNamespace>

    <PackageId>SFerrand.Common</PackageId>
    <!-- The version is not written here: MinVer derives it from the git tag (v1.2.3 gives 1.2.3).
         Untagged commits get a pre-release version (e.g. 1.2.4-preview.0.5). See RELEASING.md. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <Authors>Sébastien Ferrand</Authors>
    <Copyright>Copyright (c) 2026 Sébastien Ferrand</Copyright>
    <PackageProjectUrl>https://git.vbmaf.net/sebastien/sferrand-common</PackageProjectUrl>
    <RepositoryUrl>https://git.vbmaf.net/sebastien/sferrand-common.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <Description>Small, dependency-light helpers for .NET: secret/PII obfuscation and free-text redaction for logs (card numbers, IBAN, RIB, French identifiers), check-digit validators, log-safe JSON, string case conversion, Base64 and diacritics helpers, JSON helpers, an EnumMember-aware JSON enum converter, key-based equality comparers and configuration source ordering.</Description>
    <PackageTags>obfuscation;masking;secrets;logging;pci;iban;credit-card;redaction;pii;gdpr;luhn;base64url;string-extensions;json;case-conversion</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Fails the pack when the net8.0 and net10.0 assets differ in API; once a version is published,
         set PackageValidationBaselineVersion to also catch breaking changes against it (see RELEASING.md). -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SFerrand.Common.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.SourceLink.Gitea" Version="10.0.403">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MinVer" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
